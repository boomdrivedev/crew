#!/usr/bin/env python3
"""crew's Stop hook: at the end of each turn of a standing crew agent, one that an update of crew, or of its brief, has
made due a restart (crew.due_of, teams.19) is handed to crew _renew on its host, which restarts it on crew as it now is
once herdr reads it idle, with no question to the user open and nothing of its own running in the background but crew's
waits. One due an end instead, a main level's agent whose role now runs as its kind (crew.end_due), is handed over the
same way and ended, never started again. The end of a turn is the agent's own
good point to stop: whatever it was doing is done or handed to the background, and nothing it says is cut off.

The reviewer, started fresh for each batch, is left alone; so is every agent while its host is held, whose crew go
restarts what is due. A session crew did not start, the user's own, a Flume place's or a role's run the user opened,
that loaded crew's plugin from a build whose release names another commit than the installed crew's is offered its
restart once for each install (crew.offer_due, host-holds-and-updates "A session on an older build of crew is offered a
restart at the end of its turn"): one message shown to the person, the hook's systemMessage, naming both versions and the
session's id, which gives the model nothing; the session's mark under crew.OFFERS keeps a later turn, while the install
has not moved, to file reads alone. A session loaded from a checkout is offered nothing. The hook never fails a turn and
says nothing to the agent."""
import json
import os
import pathlib
import re
import sys

LIB = pathlib.Path(__file__).resolve().parent.parent / "lib"


def offer(sid):
    """Offer a session that is no crew agent its restart where it runs an older build of crew (crew.offer_due), once for
    each real path of the installed command, marked under crew.OFFERS."""
    if (LIB.parent.parent / ".git").exists():  # loaded from a checkout: offered nothing, and git is never asked
        return
    sys.path.insert(0, str(LIB))
    import crew
    loaded = crew.crew_read()
    if loaded["from"] != "release":
        return
    cmd = crew.installed_here()
    if cmd is None:
        return
    real, mark = os.path.realpath(cmd), crew.OFFERS / sid
    try:
        offered_for = mark.read_text().strip()
    except OSError:
        offered_for = None
    if offered_for == real:
        return
    installed = crew.installed()
    if crew.offer_due(loaded, installed, offered_for, real):
        crew.write_whole(mark, real + "\n")
        print(json.dumps({"systemMessage": crew.offer_said(loaded, installed, sid)}))


def main():
    try:
        hook = json.load(sys.stdin)
    except ValueError:
        return
    sid = hook.get("session_id")
    if not isinstance(sid, str) or not re.fullmatch(r"[A-Za-z0-9-]+", sid) or hook.get("agent_id"):
        return
    record = pathlib.Path.home() / ".local/state/crew/sessions" / sid
    name = dict(l.split("=", 1) for l in record.read_text().splitlines() if "=" in l).get("CREW_AGENT") if record.is_file() else None
    if not name:
        offer(sid)
        return
    if name.endswith("-reviewer"):
        return
    sys.path.insert(0, str(LIB))
    import crew
    fleet = crew.load()
    if crew.held() or crew.standing_role(fleet, name) is None:
        return
    due, _, started = crew.due_of(fleet, name)
    if due and started and started["session"] == sid:  # an older session of the agent's is not the one that runs
        import hold
        hold.hand(name)


if __name__ == "__main__":
    try:
        main()
    except Exception as e:  # a turn is never held up by crew's bookkeeping
        print(f"crew stop: {e}", file=sys.stderr)
